{
  "expo": {
    "name": "Finanzas en Grupo",
    "slug": "finanzas-grupo",
    "scheme": "finanzas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salmeron.finanzas",
      "infoPlist": {
        "NSCameraUsageDescription": "Para tomar foto de tickets y evidencias de gastos.",
        "NSPhotoLibraryUsageDescription": "Para adjuntar fotos de tickets y elegir tu avatar.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.salmeron.finanzas",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Finanzas en Grupo",
      "shortName": "Finanzas",
      "backgroundColor": "#6C5CE7",
      "themeColor": "#6C5CE7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#6C5CE7"
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para adjuntar fotos de tickets y elegir tu avatar.",
          "cameraPermission": "Para tomar foto de tickets y evidencias de gastos."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/spendings"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab19ba00-53c0-42f7-9252-dcd5f00fad63",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "extra": {
      "eas": {
        "projectId": "ab19ba00-53c0-42f7-9252-dcd5f00fad63"
      }
    }
  }
}
